{
  "name": "pdf-annotator",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "setup": "npm install && npm --prefix server install && npm --prefix client install",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "test": "npm --prefix server test && npm --prefix client test",
    "sample": "npm --prefix server run sample"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}